{
  "name": "pinwhy",
  "version": "0.2.0",
  "description": "Pinwhy — Agent 外置记忆：留下判断、证据与现场，跨会话接着思考",
  "homepage": "https://github.com/bx33661/pinwhy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bx33661/pinwhy.git"
  },
  "bugs": {
    "url": "https://github.com/bx33661/pinwhy/issues"
  },
  "keywords": ["pinwhy", "agent-memory", "cli", "context", "local-first"],
  "type": "module",
  "bin": {
    "pinwhy": "./bin/pinwhy.js"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "serve": "node bin/pinwhy.js serve",
    "export": "node bin/pinwhy.js export",
    "check": "npm run check:types && npm run check:docs && npm run check:publish",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:publish": "node scripts/check-publication.mjs",
    "evaluate:recovery": "node scripts/evaluate-recovery.mjs",
    "experiment:recovery": "node scripts/recovery-experiment.mjs",
    "verify:recovery": "node scripts/recovery-synthetic.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:full": "node scripts/benchmark.mjs --full",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:packages": "node scripts/pack-packages.mjs",
    "verify:npm-packages": "node scripts/verify-npm-packages.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:viewer": "node web/scripts/verify-viewer.mjs",
    "verify:exports:text": "node scripts/verify-text-exports.mjs",
    "verify:exports:sarif": "node scripts/verify-sarif.mjs",
    "verify:exports": "npm run verify:exports:text && npm run verify:exports:sarif"
  },
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "github-slugger": "2.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.60.0",
    "markdown-it": "15.0.3",
    "mermaid": "11.12.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
